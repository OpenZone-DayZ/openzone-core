                    {"label": {"name": "FfrSub", "at": [24, 35], "size": [620, 18], "text": "#STR_OZ_VPP_FFR_SUB", "font": "small", "color": "$vppMuted"}},
                    {"panel": {"name": "FfrTagBg", "anchor": "right", "at": [236, 18], "size": [180, 24], "color": "$vppRaised"}},
                    {"label": {"name": "FfrTag", "anchor": "right", "at": [236, 18], "size": [180, 24], "text": "#STR_OZ_VPP_FFR_TAG", "font": "small", "color": "$vppMuted", "align": "center"}},
                    {"button": {"name": "BtnFfrReread", "anchor": "right", "at": [24, 15], "size": [200, 30], "text": "#STR_OZ_VPP_FFR_REREAD", "font": "small", "bg": "$vppRaised", "edge": "$vppEdge", "color": "$vppText"}},
                    {"panel": {"name": "FfrHeadRule", "at": [0, 59], "size": [1060, 1], "color": "$vppEdge"}}
