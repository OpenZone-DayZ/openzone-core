                                      {"label": {"name": "FfrCapPlayers", "w": 78, "text": "#STR_OZ_VPP_FFR_COL_PLAYERS", "font": "small", "color": "$vppMuted"}},
                                      {"label": {"name": "FfrCapFaction", "w": 146, "text": "#STR_OZ_VPP_FFR_COL_FACTION", "font": "small", "color": "$vppMuted"}},
                                      {"label": {"name": "FfrCapState", "w": "fill", "text": "#STR_OZ_VPP_FFR_COL_STATE", "font": "small", "color": "$vppMuted"}}
