                                      {"button": {"name": "BtnFfrSpendNone", "w": "fill", "text": "#STR_OZ_VPP_FFR_SPEND_NONE", "font": "small", "bg": "$vppPanel", "edge": "$vppEdge", "color": "$vppMuted"}}
